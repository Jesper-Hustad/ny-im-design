<h1 id="title">Inntektsmelding for sykepenger{{#if tittelTillegg}} ({{tittelTillegg}}){{/if}}</h1>

<div class="table mt-2 width-100">
    <div class="row">
        <p style="text-align: left;" class="cell grey-text text-sm">
            Innsendt: {{formatDateTime innsendtTid}}
        </p>
        <p style="text-align: right;" class="cell grey-text text-sm">
            ID: {{id}}
        </p>
    </div>
</div>

{{!-- Den ansatte og arbeidsgiver --}}
<div class="info-box-table">
    <div class="row">
        <div class="info-box-cell box-dark" id="ansatt">
            <p class="liten-label">Den ansatte</p>
            <p class="navn-datafelt">{{#if sykmeldt.navn}}{{sykmeldt.navn}}{{else}}—{{/if}}</p>
            <p class="liten-label">Fødselsnummer</p>
            <p>{{sykmeldtFnr}}</p>
        </div>

        <div class="info-box-cell box-bright" id="arbeidsgiver">
            <p class="liten-label">Arbeidsgiver</p>
            <p class="navn-datafelt">{{#if avsender.orgNavn}}{{avsender.orgNavn}}{{else}}—{{/if}}</p>
            <div style="display: flex; gap: 20px;">
                <div>
                    <p class="liten-label">Organisasjonsnummer</p>
                    <p>{{arbeidsgiver.orgnr}}</p>
                </div>
                <div>
                    <p class="liten-label">Telefon</p>
                    <p>{{#if arbeidsgiver.tlf}}{{arbeidsgiver.tlf}}{{else}}—{{/if}}</p>
                </div>
            </div>
            <p class="liten-label" style="margin-top: 8px;">Kontaktperson</p>
            <p>{{#if avsender.navn}}{{avsender.navn}}{{else}}—{{/if}}</p>
        </div>
    </div>
</div>

{{!-- Fraværsperiode --}}
<h2 id="fravaersperiode">Fraværsperiode</h2>

<p class="label mb-2">Bestemmende fraværsdag (skjæringstidspunkt)</p>
<p class="value mb-4">{{#if inntekt}}{{#if inntekt.inntektsdato}}{{formatDate inntekt.inntektsdato}}{{else}}—{{/if}}{{else}}—{{/if}}</p>

<p class="label mb-2">Arbeidsgiverperiode</p>
{{#if agp}}
    {{#if (hasItems agp.perioder)}}
        {{#each agp.perioder}}
            <div class="period-row mb-2">
                <p>{{periodeMedDager fom tom}}</p>
            </div>
        {{/each}}
    {{else}}
        <p class="value mb-3">Ingen arbeidsgiverperiode</p>
    {{/if}}
{{else}}
    <p class="value mb-3">Ingen arbeidsgiverperiode</p>
{{/if}}

{{#if egenmeldinger}}
    {{#if (hasItems egenmeldinger)}}
        <p class="label mb-2" style="margin-top: 12px;">Egenmeldinger</p>
        {{#each egenmeldinger}}
            <div class="period-row mb-2">
                <p>{{periodeMedDager fom tom}}</p>
            </div>
        {{/each}}
    {{/if}}
{{/if}}

<p class="label mb-2" style="margin-top: 12px;">Sykmeldingsperioder</p>
{{#if sykmeldingsperioder}}
    {{#each sykmeldingsperioder}}
        <div class="period-row mb-2">
            <p>{{periodeMedDager fom tom}}</p>
        </div>
    {{/each}}
{{else}}
    <p class="value mb-3">Ingen sykmeldingsperioder oppgitt.</p>
{{/if}}

{{!-- Flere arbeidsforhold --}}
{{#if flereArbeidsforhold}}
<h2 id="flerearbeidsforhold">Flere arbeidsforhold</h2>

<p class="label mb-1">Har lik lønn i alle arbeidsforhold?</p>
<p class="value mb-3">{{#if flereArbeidsforhold.harLikLoenn}}Ja{{else}}Nei{{/if}}</p>

<p class="label mb-1">Er sykmeldt fra alle arbeidsforhold?</p>
<p class="value mb-3">{{#if flereArbeidsforhold.erSykmeldtFraAlle}}Ja{{else}}Nei{{/if}}</p>

{{#unless flereArbeidsforhold.harLikLoenn}}
    <p class="label mb-2">Arbeidsforhold</p>
    {{#each flereArbeidsforhold.arbeidsforhold}}
        <div class="period-row mb-2">
            <div class="table width-100">
                <div class="row">
                    <p class="cell label" style="width: 35%;">{{yrkesbeskrivelse}}</p>
                    <p class="cell" style="width: 20%;">{{stillingsprosent}} %</p>
                    <p class="cell" style="width: 25%;">{{inntekt}} kr/mnd</p>
                    <p class="cell" style="width: 20%;">{{#if inkludertISykefravaer}}Ja{{else}}Nei{{/if}}</p>
                </div>
            </div>
        </div>
    {{/each}}
{{/unless}}
{{/if}}

{{!-- Beregnet månedslønn --}}
<h2 id="inntekt">Beregnet månedslønn</h2>

{{#if inntekt}}
    <p class="label mb-1">Registrert inntekt{{#if inntekt.inntektsdato}} (per {{formatDate inntekt.inntektsdato}}){{/if}}</p>
    <p class="value-lg mb-4">{{#if inntekt.beloep}}{{inntekt.beloep}} kr/måned{{else}}—{{/if}}</p>

    {{#if (hasItems inntekt.endringAarsaker)}}
        {{#each inntekt.endringAarsaker}}
            <div class="period-row mb-2">
                <p class="label">
                    Endringsårsak{{#if (gt ../inntekt.endringAarsaker.length 1)}} ({{inc @index}} av {{../inntekt.endringAarsaker.length}}){{/if}}
                </p>
                <p>{{aarsak}}</p>
                {{#if gjelderFra}}
                    <p class="detail">Gjelder fra: {{formatDate gjelderFra}}</p>
                {{/if}}
                {{#if bleKjent}}
                    <p class="detail">Ble kjent: {{formatDate bleKjent}}</p>
                {{/if}}
                {{#if perioder}}
                    {{#each perioder}}
                        <p class="detail">{{formatDate fom}} – {{formatDate tom}}</p>
                    {{/each}}
                {{/if}}
            </div>
        {{/each}}
    {{/if}}
{{else}}
    <p class="value mb-3">Inntekt ikke oppgitt</p>
{{/if}}

{{!-- Refusjon --}}
<h2 id="refusjon">Refusjon</h2>

{{!-- Lønn i arbeidsgiverperioden --}}
{{#if agp}}
    {{#if (hasItems agp.perioder)}}
        <p class="label mb-1">Betaler arbeidsgiver full lønn i arbeidsgiverperioden?</p>
        {{#if agp.redusertLoennIAgp}}
            <p class="value mb-3">Nei</p>
            <p class="label mb-1">Begrunnelse</p>
            <p class="value mb-3">{{agp.redusertLoennIAgp.begrunnelse}}</p>
            <p class="label mb-1">Utbetalt under arbeidsgiverperiode</p>
            <p class="value mb-4">{{agp.redusertLoennIAgp.beloep}} kr</p>
        {{else}}
            <p class="value mb-4">Ja</p>
        {{/if}}
    {{else}}
        <p class="value mb-4">Ingen arbeidsgiverperiode</p>
    {{/if}}
{{else}}
    <p class="value mb-4">Ingen arbeidsgiverperiode</p>
{{/if}}

{{!-- Refusjon etter AGP --}}
<p class="label mb-1">Betaler arbeidsgiver lønn under hele eller deler av sykefraværet?</p>
{{#if refusjon}}
    <p class="value mb-3">Ja</p>

    <p class="label mb-1">Refusjonsbeløp per måned</p>
    <p class="value mb-3">{{refusjon.beloepPerMaaned}} kr/måned</p>

    {{#if (hasItems refusjon.endringer)}}
        <p class="label mb-2">Endringer i refusjonsbeløp</p>
        {{#each refusjon.endringer}}
            <div class="period-row mb-2">
                <div class="table width-100">
                    <div class="row">
                        <p class="cell label">{{beloep}} kr/måned</p>
                        <p class="cell" style="text-align: right;">Fra {{formatDate startdato}}</p>
                    </div>
                </div>
            </div>
        {{/each}}
    {{/if}}

    {{#if refusjon.sluttdato}}
        <p class="label mb-1">Siste dag med refusjon</p>
        <p class="value mb-3">{{formatDate refusjon.sluttdato}}</p>
    {{/if}}
{{else}}
    <p class="value mb-3">Nei</p>
{{/if}}

{{!-- Naturalytelser --}}
<h2 id="naturalytelser">Bortfall av naturalytelser</h2>

{{#if (hasItems naturalytelser)}}
    {{#each naturalytelser}}
        <div class="period-row mb-2">
            <div class="table width-100">
                <div class="row">
                    <p class="cell" style="width: 40%;">{{naturalytelse}}</p>
                    <p class="cell" style="width: 30%;">Fra {{formatDate sluttdato}}</p>
                    <p class="cell" style="width: 30%;">{{verdiBeloep}} kr/mnd</p>
                </div>
            </div>
        </div>
    {{/each}}
{{else}}
    <p class="value mb-3">Ingen bortfall av naturalytelser</p>
{{/if}}

<hr/>

<p class="grey-text text-sm" style="margin-top: 15px;">
    Årsak innsending: {{aarsakInnsending}} |
    Type: {{typeInnsending}}
    {{#if avsender.systemNavn}} | Sendt via: {{avsender.systemNavn}} v{{avsender.systemVersjon}}{{/if}}
</p>
